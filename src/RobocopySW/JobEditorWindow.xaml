<Window x:Class="RobocopySW.JobEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Modifica job" Height="700" Width="720"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="Margin" Value="0,8,8,2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="Hint">
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="14">
        <Border DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Annulla" Width="100" Margin="0,0,8,0" IsCancel="True" Click="OnCancel"/>
                <Button Content="Salva" Width="100" IsDefault="True" Click="OnSave"/>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Nome" Style="{StaticResource Label}"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Sorgente" Style="{StaticResource Label}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding Source, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Grid.Column="1" Content="Sfoglia…" Margin="6,0,0,0" Padding="10,2" Click="OnBrowseSource"/>
                </Grid>

                <TextBlock Text="Destinazione" Style="{StaticResource Label}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding Destination, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Grid.Column="1" Content="Sfoglia…" Margin="6,0,0,0" Padding="10,2" Click="OnBrowseDest"/>
                </Grid>

                <CheckBox Content="Mirror (rende la destinazione identica alla sorgente: CANCELLA i file rimossi)"
                          IsChecked="{Binding Mirror}" Margin="0,12,0,0"/>
                <TextBlock Style="{StaticResource Hint}"
                           Text="Disattivato = copia e aggiorna soltanto, senza mai cancellare in destinazione."/>

                <CheckBox Content="Non sovrascrivere i file più recenti in destinazione (/XO)" IsChecked="{Binding ExcludeOlder}" Margin="0,6,0,0"/>
                <CheckBox Content="Copia anche ACL/owner (/COPYALL — utile su share di rete)" IsChecked="{Binding CopyAll}" Margin="0,6,0,0"/>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Thread (/MT)" Style="{StaticResource Label}"/>
                        <TextBox Text="{Binding MultiThread, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Tentativi (/R)" Style="{StaticResource Label}"/>
                        <TextBox Text="{Binding Retries, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Attesa sec (/W)" Style="{StaticResource Label}"/>
                        <TextBox Text="{Binding Wait, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Credenziale di rete (per share UNC)" Style="{StaticResource Label}"/>
                <ComboBox ItemsSource="{Binding Credentials}" SelectedItem="{Binding SelectedCredential}"
                          DisplayMemberPath="Display"/>

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Escludi file (uno per riga)" Style="{StaticResource Label}"/>
                        <TextBox Text="{Binding ExcludeFilesText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" Height="70" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Escludi cartelle (una per riga)" Style="{StaticResource Label}"/>
                        <TextBox Text="{Binding ExcludeDirsText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" Height="70" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Grid>

                <CheckBox Content="Job attivo (incluso in «Avvia tutti»)" IsChecked="{Binding Enabled}" Margin="0,12,0,0"/>

                <TextBlock Text="Anteprima comando robocopy" Style="{StaticResource Label}"/>
                <TextBox Text="{Binding CommandPreview, Mode=OneWay}" IsReadOnly="True"
                         FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                         Background="#1E1E1E" Foreground="#9CDCFE" Padding="6" MinHeight="60"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
