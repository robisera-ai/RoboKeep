<ui:FluentWindow x:Class="RoboKeep.JobWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:ctl="clr-namespace:RoboKeep.Controls"
        xmlns:l="clr-namespace:RoboKeep.Localization"
        mc:Ignorable="d"
        Title="{l:Tr Wiz_Title}" Height="660" Width="720"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        WindowStartupLocation="CenterOwner">
    <ui:FluentWindow.Resources>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="Margin" Value="0,12,8,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="Hint">
            <Setter Property="Opacity" Value="0.7"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="StepTitle">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,4,0,10"/>
        </Style>
        <!-- WPF-UI da' al CheckBox un Padding sinistro di 11 px e al RadioButton 0: nel passo 2 le
             caselle sotto le due scelte sembravano sottovoci di «Accumulare». Stesso filo a sinistra. -->
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Padding" Value="0,5,0,6"/>
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{l:Tr Wiz_Title}">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Add24"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="20,4,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{Binding StepLabel}" Opacity="0.7" Margin="0,0,0,6"/>

            <TabControl Grid.Row="1" SelectedIndex="{Binding CurrentStep}" BorderThickness="0" Background="Transparent">
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Style>
                </TabControl.ItemContainerStyle>

                <!-- Passo 1: dati di base -->
                <TabItem>
                    <StackPanel>
                        <TextBlock Text="{l:Tr Wiz_Step1Title}" Style="{StaticResource StepTitle}"/>
                        <TextBlock Text="{l:Tr Editor_Name}" Style="{StaticResource Label}"/>
                        <ui:TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="{l:Tr Editor_Source}" Style="{StaticResource Label}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0" Text="{Binding Source, UpdateSourceTrigger=PropertyChanged}"/>
                            <ui:Button Grid.Column="1" Content="{l:Tr Common_Browse}" Icon="{ui:SymbolIcon FolderOpen24}" Margin="8,0,0,0" Click="OnBrowseSource"/>
                        </Grid>
                        <TextBlock Text="{l:Tr Editor_Dest}" Style="{StaticResource Label}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0" Text="{Binding Destination, UpdateSourceTrigger=PropertyChanged}"/>
                            <ui:Button Grid.Column="1" Content="{l:Tr Common_Browse}" Icon="{ui:SymbolIcon FolderOpen24}" Margin="8,0,0,0" Click="OnBrowseDest"/>
                        </Grid>
                    </StackPanel>
                </TabItem>

                <!-- Passo 2: comportamento -->
                <TabItem>
                    <StackPanel>
                        <TextBlock Text="{l:Tr Wiz_Step2Title}" Style="{StaticResource StepTitle}"/>
                        <TextBlock Text="{l:Tr Wiz_SyncQuestion}" Style="{StaticResource Label}"/>
                        <RadioButton Content="{l:Tr Wiz_SyncMirror}" IsChecked="{Binding Mirror}" GroupName="sync"/>
                        <RadioButton Content="{l:Tr Wiz_SyncAccumulate}" IsChecked="{Binding Accumulate}" GroupName="sync" Margin="0,4,0,0"/>
                        <CheckBox Content="{l:Tr Wiz_Large}" IsChecked="{Binding HasLargeFiles}" Margin="0,18,0,0"/>
                        <CheckBox Content="{l:Tr Wiz_KeepVersions}" IsChecked="{Binding KeepVersions}" Margin="0,18,0,0"/>
                        <TextBlock Style="{StaticResource Hint}" Text="{l:Tr Wiz_KeepVersionsHint}"/>
                        <StackPanel Orientation="Horizontal" Margin="24,6,0,0">
                            <TextBlock Text="{l:Tr Wiz_VersionsToKeep}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ui:TextBox Text="{Binding VersionsToKeep, UpdateSourceTrigger=PropertyChanged, FallbackValue=10}"
                                        IsEnabled="{Binding KeepVersions}" Width="90"/>
                        </StackPanel>
                        <ui:InfoBar Margin="0,6,0,0" Severity="Warning" IsClosable="False"
                                    IsOpen="{Binding ShowVersionsNote, Mode=OneWay}" Message="{l:Tr Preflight_NoHardLink}"/>
                        <!-- Pianificazione: stessi controlli dell'editor (frequenza, giorno, orario). -->
                        <TextBlock Text="{l:Tr Wiz_Schedule}" Style="{StaticResource Label}" Margin="0,18,8,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="{l:Tr Editor_ScheduleFreq}" Style="{StaticResource Label}" Margin="0,0,8,4"/>
                                <ComboBox SelectedIndex="{Binding ScheduleIndex}">
                                    <ComboBoxItem Content="{l:Tr Sched_KindNone}"/>
                                    <ComboBoxItem Content="{l:Tr Sched_Daily}"/>
                                    <ComboBoxItem Content="{l:Tr Sched_Weekly}"/>
                                    <ComboBoxItem Content="{l:Tr Sched_KindMonthly}"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="{l:Tr Sched_Time}" Style="{StaticResource Label}" Margin="0,0,8,4"/>
                                <ui:TextBox Text="{Binding ScheduleTime, UpdateSourceTrigger=PropertyChanged}"
                                            IsEnabled="{Binding ScheduleEnabled}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <StackPanel Visibility="{Binding ShowWeekDay, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{l:Tr Editor_ScheduleDay}" Style="{StaticResource Label}" Margin="0,0,8,4"/>
                                    <ComboBox SelectedIndex="{Binding ScheduleWeekDayIndex}">
                                        <ComboBoxItem Content="{l:Tr Day_Mon}"/>
                                        <ComboBoxItem Content="{l:Tr Day_Tue}"/>
                                        <ComboBoxItem Content="{l:Tr Day_Wed}"/>
                                        <ComboBoxItem Content="{l:Tr Day_Thu}"/>
                                        <ComboBoxItem Content="{l:Tr Day_Fri}"/>
                                        <ComboBoxItem Content="{l:Tr Day_Sat}"/>
                                        <ComboBoxItem Content="{l:Tr Day_Sun}"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Visibility="{Binding ShowMonthDay, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{l:Tr Editor_ScheduleMonthDay}" Style="{StaticResource Label}" Margin="0,0,8,4"/>
                                    <ui:TextBox Text="{Binding ScheduleMonthDay, UpdateSourceTrigger=PropertyChanged, FallbackValue=1}"
                                                IsEnabled="{Binding ScheduleFixedDayEnabled}"/>
                                    <CheckBox Content="{l:Tr Sched_LastDay}" IsChecked="{Binding ScheduleLastDayOfMonth}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Text="{l:Tr Editor_ScheduleHint}"/>
                    </StackPanel>
                </TabItem>

                <!-- Passo 3: casi speciali -->
                <TabItem>
                    <StackPanel>
                        <TextBlock Text="{l:Tr Wiz_Step3Title}" Style="{StaticResource StepTitle}"/>
                        <CheckBox Content="{l:Tr Wiz_Frozen}" IsChecked="{Binding HasFrozen}"/>
                        <TextBlock Style="{StaticResource Hint}" Text="{l:Tr Wiz_FrozenHint}"/>
                        <TextBlock Text="{l:Tr Wiz_FrozenPatterns}" Style="{StaticResource Label}"/>
                        <ui:TextBox Text="{Binding FrozenPatternsText, UpdateSourceTrigger=PropertyChanged}"
                                    IsEnabled="{Binding HasFrozen}" AcceptsReturn="True" Height="56"
                                    TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" PlaceholderText="*.pst"/>
                        <CheckBox Content="{l:Tr Wiz_Perms}" IsChecked="{Binding PreservePermissions}" Margin="0,14,0,0"/>
                        <TextBlock Style="{StaticResource Hint}" Text="{l:Tr Wiz_PermsHint}"/>
                        <CheckBox Content="{l:Tr Wiz_Excl}" IsChecked="{Binding ExcludeCommonTemp}" Margin="0,14,0,0"/>
                        <CheckBox Content="{l:Tr Wiz_OpenFiles}" IsChecked="{Binding HasOpenFiles}" Margin="0,14,0,0"/>
                        <TextBlock Style="{StaticResource Hint}" Text="{l:Tr Wiz_OpenFilesHint}"/>
                    </StackPanel>
                </TabItem>

                <!-- Passo 4: riepilogo -->
                <TabItem>
                    <StackPanel>
                        <TextBlock Text="{l:Tr Wiz_Step4Title}" Style="{StaticResource StepTitle}"/>
                        <TextBlock Text="{l:Tr Wiz_Summary}" Style="{StaticResource Label}"/>
                        <Border CornerRadius="6" Background="#1E1E1E" Padding="10">
                            <TextBox Text="{Binding CommandPreview, Mode=OneWay}" IsReadOnly="True" Style="{x:Null}"
                                     FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap"
                                     Background="#1E1E1E" Foreground="#9CDCFE" BorderThickness="0" MinHeight="90"/>
                        </Border>
                        <!-- Share di rete: credenziale gia' salvata -> solo un avviso; altrimenti si chiede qui. -->
                        <ui:InfoBar Margin="0,12,0,0" Severity="Informational" IsClosable="False"
                                    IsOpen="{Binding ShowNetCredExisting, Mode=OneWay}" Message="{Binding NetCredIntro, Mode=OneWay}"/>
                        <StackPanel Visibility="{Binding ShowNetCredFields, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding NetCredIntro, Mode=OneWay}" Style="{StaticResource Hint}" Margin="0,12,0,0"/>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="{l:Tr Wiz_NetCredUser}" Style="{StaticResource Label}" Margin="0,0,8,4"/>
                                    <ui:TextBox Text="{Binding NetUser, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{l:Tr Wiz_NetCredPassword}" Style="{StaticResource Label}" Margin="0,0,8,4"/>
                                    <PasswordBox x:Name="NetPasswordBox"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </Grid>

        <Border Grid.Row="2" Padding="20,12" Background="#11888888">
            <Grid>
                <ui:Button Content="{l:Tr Wiz_Skip}" HorizontalAlignment="Left" Click="OnSkip"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="{l:Tr Common_Cancel}" Width="100" Margin="0,0,8,0" IsCancel="True" Click="OnCancel"/>
                    <ui:Button Content="{l:Tr Wiz_Back}" Width="100" Margin="0,0,8,0" IsEnabled="{Binding CanGoBack}" Click="OnBack"/>
                    <ui:Button Content="{l:Tr Wiz_Next}" Width="120" Appearance="Primary" Click="OnNext"
                               IsEnabled="{Binding CanGoNext}"
                               Visibility="{Binding ShowNext, Converter={StaticResource BoolToVis}}"/>
                    <ui:Button Content="{l:Tr Wiz_Open}" Width="170" Appearance="Primary" Icon="{ui:SymbolIcon Save24}" Click="OnOpen"
                               Visibility="{Binding ShowOpen, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
