<ui:FluentWindow x:Class="RoboKeep.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:l="clr-namespace:RoboKeep.Localization"
        mc:Ignorable="d"
        Title="{l:Tr Settings_Title}" Height="660" Width="740"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        WindowStartupLocation="CenterOwner">
    <ui:FluentWindow.Resources>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="Margin" Value="0,12,8,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{l:Tr Settings_Title}">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Settings24"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <TabControl Grid.Row="1" Margin="20,4,20,0">
            <!-- GENERALE -->
            <TabItem Header="{l:Tr Tab_General}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,14,0">
                <StackPanel Margin="4,12">
                    <TextBlock Text="{l:Tr Set_Language}" Style="{StaticResource Label}"/>
                    <ComboBox Width="260" HorizontalAlignment="Left"
                              SelectedValuePath="Tag" SelectedValue="{Binding LanguageSetting}">
                        <ComboBoxItem Tag="auto" Content="{l:Tr Lang_Auto}"/>
                        <ComboBoxItem Tag="it" Content="Italiano"/>
                        <ComboBoxItem Tag="en" Content="English"/>
                        <ComboBoxItem Tag="es" Content="Español"/>
                        <ComboBoxItem Tag="fr" Content="Français"/>
                        <ComboBoxItem Tag="de" Content="Deutsch"/>
                    </ComboBox>

                    <TextBlock Text="{l:Tr Set_LogFolder}" Style="{StaticResource Label}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0" x:Name="LogRootBox" Text="{Binding LogRoot, UpdateSourceTrigger=PropertyChanged}"/>
                        <ui:Button Grid.Column="1" Content="{l:Tr Common_Browse}" Icon="{ui:SymbolIcon FolderOpen24}" Margin="8,0,0,0" Click="OnBrowseLog"/>
                    </Grid>

                    <TextBlock Text="{l:Tr Set_TempFolder}" Style="{StaticResource Label}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0" x:Name="TempRootBox" Text="{Binding TempRoot, UpdateSourceTrigger=PropertyChanged}"/>
                        <ui:Button Grid.Column="1" Content="{l:Tr Common_Browse}" Icon="{ui:SymbolIcon FolderOpen24}" Margin="8,0,0,0" Click="OnBrowseTemp"/>
                    </Grid>

                    <TextBlock Opacity="0.7" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" Text="{l:Tr Set_PathsHint}"/>

                    <CheckBox Content="{l:Tr Set_Compress}" IsChecked="{Binding CompressLogs}" Margin="0,16,0,0"/>

                    <TextBlock Text="{l:Tr Set_Retention}" Style="{StaticResource Label}"/>
                    <ui:TextBox Width="140" HorizontalAlignment="Left" Text="{Binding LogRetentionDays, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="{l:Tr Set_CredSecurity}" Style="{StaticResource Label}"/>
                    <CheckBox Content="{l:Tr Set_CredScopeUser}" IsChecked="{Binding CredentialScopeUser}"/>
                    <TextBlock Opacity="0.7" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" Text="{l:Tr Set_CredScopeHint}"/>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- EMAIL -->
            <TabItem Header="{l:Tr Tab_Email}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,14,0">
                    <StackPanel Margin="4,12">
                        <CheckBox Content="{l:Tr Email_Enable}" IsChecked="{Binding EmailEnabled}"/>

                        <StackPanel IsEnabled="{Binding EmailEnabled}" Margin="0,4,0,0">
                            <CheckBox Content="{l:Tr Email_OnlyError}" IsChecked="{Binding OnlyOnError}" Margin="0,4,0,0"/>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="{l:Tr Email_Smtp}" Style="{StaticResource Label}"/>
                                    <ui:TextBox Text="{Binding SmtpHost, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{l:Tr Email_Port}" Style="{StaticResource Label}"/>
                                    <ui:TextBox Text="{Binding SmtpPort, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>

                            <CheckBox Content="{l:Tr Email_Ssl}" IsChecked="{Binding UseSsl}" Margin="0,8,0,0"/>

                            <!-- Da | A affiancati -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="{l:Tr Email_From}" Style="{StaticResource Label}"/>
                                    <ui:TextBox Text="{Binding EmailFrom, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{l:Tr Email_To}" Style="{StaticResource Label}"/>
                                    <ui:TextBox Text="{Binding EmailTo, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Utente | Password affiancati -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="{l:Tr Email_User}" Style="{StaticResource Label}"/>
                                    <ui:TextBox Text="{Binding EmailUser, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{l:Tr Email_Pwd}" Style="{StaticResource Label}"/>
                                    <PasswordBox x:Name="EmailPasswordBox"/>
                                </StackPanel>
                            </Grid>

                            <!-- Stato a sinistra, pulsante in basso a destra -->
                            <Grid Margin="0,14,0,0">
                                <TextBlock x:Name="EmailTestStatus" VerticalAlignment="Center"
                                           TextWrapping="Wrap" Margin="0,0,12,0"/>
                                <ui:Button x:Name="TestEmailButton" HorizontalAlignment="Right"
                                           Content="{l:Tr Email_TestButton}" Icon="{ui:SymbolIcon Send24}"
                                           Appearance="Primary" Click="OnSendTestEmail"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- CREDENZIALI -->
            <TabItem Header="{l:Tr Tab_Credentials}">
                <DockPanel Margin="4,12">
                    <ui:Card DockPanel.Dock="Bottom" Margin="0,10,0,0" Padding="14">
                        <StackPanel>
                            <TextBlock Text="{l:Tr Cred_AddUpdate}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="{l:Tr Cred_Name}" Style="{StaticResource Label}"/>
                                    <ui:TextBox x:Name="CredId"/>
                                    <TextBlock Text="{l:Tr Cred_User}" Style="{StaticResource Label}"/>
                                    <ui:TextBox x:Name="CredUser"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="{l:Tr Cred_Host}" Style="{StaticResource Label}"/>
                                    <ui:TextBox x:Name="CredHost"/>
                                    <TextBlock Text="{l:Tr Cred_Pwd}" Style="{StaticResource Label}"/>
                                    <PasswordBox x:Name="CredPassword"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <ui:Button x:Name="TestCredButton" Content="{l:Tr Conn_Test}" Icon="{ui:SymbolIcon PlugConnected24}" Click="OnTestCredential"/>
                                    <ui:Button Content="{l:Tr Cred_Remove}" Icon="{ui:SymbolIcon Delete24}" Margin="8,0,0,0" Click="OnRemoveCredential"/>
                                </StackPanel>
                                <ui:Button Content="{l:Tr Cred_Save}" Icon="{ui:SymbolIcon Save24}" Appearance="Primary" HorizontalAlignment="Right" Click="OnUpsertCredential"/>
                            </Grid>
                            <TextBlock x:Name="CredTestStatus" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ui:Card>

                    <DataGrid x:Name="CredGrid" ItemsSource="{Binding CredentialList}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                              Background="Transparent" BorderThickness="0" GridLinesVisibility="None"
                              SelectionChanged="OnCredentialSelected">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{l:Tr Cred_Name}" Binding="{Binding Id}" Width="*"/>
                            <DataGridTextColumn Header="Host" Binding="{Binding Host}" Width="2*"/>
                            <DataGridTextColumn Header="{l:Tr Cred_ColUser}" Binding="{Binding User}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- PIANIFICAZIONE -->
            <TabItem Header="{l:Tr Tab_Schedule}">
                <StackPanel Margin="4,12">
                    <ui:InfoBar IsOpen="True" Severity="Informational" IsClosable="False"
                                Title="{l:Tr Sched_InfoTitle}" Message="{l:Tr Sched_InfoMsg}"/>

                    <ui:Card Margin="0,10,0,0" Padding="12">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Clock24" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ScheduleInfo" VerticalAlignment="Center" TextWrapping="Wrap" FontWeight="SemiBold"/>
                        </StackPanel>
                    </ui:Card>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="{l:Tr Sched_Time}" Style="{StaticResource Label}"/>
                            <ui:TextBox x:Name="ScheduleTime" Text="22:00"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{l:Tr Sched_Freq}" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="ScheduleFreq" SelectedIndex="0">
                                <ComboBoxItem Content="{l:Tr Sched_Daily}"/>
                                <ComboBoxItem Content="{l:Tr Sched_Weekly}"/>
                                <ComboBoxItem Content="{l:Tr Sched_Once}"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <ui:Button Content="{l:Tr Sched_Create}" Icon="{ui:SymbolIcon CalendarClock24}" Appearance="Primary" Click="OnCreateSchedule"/>
                        <ui:Button Content="{l:Tr Sched_Remove}" Icon="{ui:SymbolIcon Delete24}" Margin="8,0,0,0" Click="OnRemoveSchedule"/>
                    </StackPanel>
                    <TextBlock x:Name="ScheduleStatus" Margin="0,12,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </TabItem>

            <!-- AFFIDABILITA E NOTIFICHE -->
            <TabItem Header="{l:Tr Tab_Reliability}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,14,0">
                    <StackPanel Margin="4,12">
                        <TextBlock Text="{l:Tr Set_ReliabilitySection}" Style="{StaticResource Label}" Margin="4,4,4,8"/>

                        <TextBlock Text="{l:Tr Set_StaleAfterDays}" Style="{StaticResource Label}"/>
                        <ui:TextBox Width="140" HorizontalAlignment="Left" Text="{Binding StaleAfterDays, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="{l:Tr Set_MinFreeSpace}" Style="{StaticResource Label}"/>
                        <ui:TextBox Width="140" HorizontalAlignment="Left" Text="{Binding MinFreeSpaceMb, UpdateSourceTrigger=PropertyChanged}"/>

                        <CheckBox Content="{l:Tr Set_PreflightEnabled}" IsChecked="{Binding PreflightEnabled}" Margin="0,16,0,0"/>
                        <CheckBox Content="{l:Tr Set_NotificationsEnabled}" IsChecked="{Binding NotificationsEnabled}" Margin="0,8,0,0"/>
                        <CheckBox Content="{l:Tr Set_MinimizeToTray}" IsChecked="{Binding MinimizeToTray}" Margin="0,8,0,0"/>
                        <CheckBox Content="{l:Tr Set_StartMinimized}" IsChecked="{Binding StartMinimized}" IsEnabled="{Binding MinimizeToTray}" Margin="0,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- INFO / ABOUT -->
            <TabItem Header="{l:Tr Tab_About}">
                <StackPanel Margin="4,16">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="FolderArrowRight24" FontSize="28" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="RoboKeep" FontSize="26" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{l:Tr About_Desc}" Opacity="0.85" TextWrapping="Wrap" Margin="0,6,0,0"/>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <TextBlock Text="{l:Tr About_Version}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="AppVersionText" Margin="6,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="© 2026 Roberto Serafini" Margin="0,8,0,0"/>
                    <TextBlock Text="{l:Tr About_License}" Margin="0,2,0,0"/>
                    <TextBlock Text="{l:Tr About_BuiltOn}"
                               Opacity="0.8" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    <TextBlock Margin="0,12,0,0">
                        <Hyperlink NavigateUri="https://github.com/robisera-ai/RoboKeep" RequestNavigate="OnOpenLink">github.com/robisera-ai/RoboKeep</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Padding="20,12" Background="#11888888">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="{l:Tr Common_Cancel}" Width="110" Margin="0,0,8,0" IsCancel="True" Click="OnCancel"/>
                <ui:Button Content="{l:Tr Common_Save}" Width="110" Appearance="Primary" Icon="{ui:SymbolIcon Save24}" IsDefault="True" Click="OnSave"/>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
