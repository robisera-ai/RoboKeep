<ui:FluentWindow x:Class="RoboKeep.SnapshotsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:l="clr-namespace:RoboKeep.Localization"
        mc:Ignorable="d"
        Title="{l:Tr Ver_Browse}" Height="420" Width="520"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{l:Tr Ver_Browse}">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="History24"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Border Grid.Row="1" Margin="16,8,16,8" CornerRadius="8" BorderThickness="1"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid>
                <!-- Lista snapshot -->
                <ListBox x:Name="SnapshotList"
                         ItemsSource="{Binding Snapshots}"
                         Background="Transparent" BorderThickness="0"
                         Padding="4"
                         Visibility="{Binding HasSnapshots, Converter={StaticResource BoolToVis}}"
                         MouseDoubleClick="OnSnapshotDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas" FontSize="13" Padding="4,2"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Stato vuoto -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="320"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <ui:SymbolIcon Symbol="History24" FontSize="40" HorizontalAlignment="Center" Opacity="0.5"/>
                    <TextBlock Text="{l:Tr Ver_NoSnapshots}" TextAlignment="Center" TextWrapping="Wrap"
                               Margin="0,12,0,0" Opacity="0.7"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,0,16,16">
            <ui:Button Icon="{ui:SymbolIcon FolderOpen24}" Content="{l:Tr Ver_OpenInExplorer}"
                       Appearance="Primary" Margin="0,0,8,0"
                       Click="OnOpenInExplorer"/>
            <ui:Button Content="{l:Tr Common_Cancel}" Appearance="Secondary"
                       Click="OnClose"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
