<ui:FluentWindow x:Class="RoboKeep.PreflightWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:l="clr-namespace:RoboKeep.Localization"
        Title="{l:Tr Preflight_ConfirmTitle}" Width="640" SizeToContent="Height" MaxHeight="640"
        ResizeMode="NoResize" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
        WindowCornerPreference="Round" WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="{l:Tr Preflight_ConfirmTitle}">
            <ui:TitleBar.Icon><ui:SymbolIcon Symbol="HardDrive24"/></ui:TitleBar.Icon>
        </ui:TitleBar>
        <ScrollViewer Grid.Row="1" Margin="20,8,20,8" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="Body" TextWrapping="Wrap"/>
        </ScrollViewer>
        <!-- Cosa fa «Ho controllato»: si vede solo quando il pulsante c'e'. -->
        <TextBlock Grid.Row="2" x:Name="AckHint" Text="{l:Tr Preflight_AckHint}" TextWrapping="Wrap"
                   Margin="20,0,20,8" Opacity="0.75"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,8,20,20">
            <ui:Button x:Name="AckButton" Content="{l:Tr Preflight_AckStart}" Margin="0,0,8,0" Click="OnAcknowledge"/>
            <ui:Button Content="{l:Tr Preflight_Start}" Appearance="Primary" Margin="0,0,8,0" Click="OnStart"/>
            <ui:Button Content="{l:Tr Preflight_Cancel}" IsCancel="True" Click="OnCancel"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
