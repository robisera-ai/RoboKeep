<ui:FluentWindow x:Class="RoboKeep.DiskHealthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:l="clr-namespace:RoboKeep.Localization"
        Title="{l:Tr Smart_Title}" Width="760" Height="640" MinWidth="560" MinHeight="420"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
        WindowCornerPreference="Round" WindowStartupLocation="CenterOwner">

    <ui:FluentWindow.Resources>
        <!-- Spiegazione della riga: sempre a capo, in secondo piano rispetto al valore. -->
        <Style TargetType="TextBlock" x:Key="Hint">
            <Setter Property="Opacity" Value="0.7"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Verdetto della scheda: il colore e' il messaggio, il testo lo ripete a parole.
             I colori vengono dal tema di WPF-UI, cosi' restano leggibili in chiaro e in scuro. -->
        <Style TargetType="TextBlock" x:Key="Verdict">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="Good">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Warning">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Danger">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Unreadable">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Valore della riga: colorato solo quando la riga stessa e' un avviso. -->
        <Style TargetType="TextBlock" x:Key="RowValue">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="Warning">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Danger">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{l:Tr Smart_Title}">
            <ui:TitleBar.Icon><ui:SymbolIcon Symbol="HardDrive24"/></ui:TitleBar.Icon>
        </ui:TitleBar>

        <TextBlock Grid.Row="1" Text="{l:Tr Smart_Intro}" TextWrapping="Wrap" Opacity="0.8"
                   Margin="16,4,16,0"/>

        <Grid Grid.Row="2" Margin="16,10,16,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ui:Button Grid.Column="0" Icon="{ui:SymbolIcon ArrowSync24}" Content="{l:Tr Smart_Refresh}"
                       Appearance="Primary" IsEnabled="{Binding CanRefresh}" Click="OnRefresh"/>
            <TextBlock Grid.Column="1" Text="{Binding Status}" TextWrapping="Wrap" Opacity="0.8"
                       VerticalAlignment="Center" Margin="12,0,0,0"/>
        </Grid>

        <ScrollViewer Grid.Row="3" Margin="16,0,16,16" VerticalScrollBarVisibility="Auto"
                      Padding="0,0,4,0">
            <ItemsControl ItemsSource="{Binding Disks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Card Margin="0,0,0,12" Padding="14">
                            <StackPanel>
                                <!-- Intestazione: modello, bus, lettere; a destra il verdetto. -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Title}" FontWeight="SemiBold"
                                               FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding LevelText}"
                                               Style="{StaticResource Verdict}" Margin="12,0,0,0"/>
                                </Grid>

                                <!-- Perche' il disco non si legge (autorizzazione o box USB). -->
                                <TextBlock Text="{Binding Note}" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}"/>

                                <!-- Righe del referto: etichetta, valore, spiegazione. Le colonne
                                     sono allineate tra le righe grazie a IsSharedSizeScope. -->
                                <ItemsControl ItemsSource="{Binding Rows}" Grid.IsSharedSizeScope="True"
                                              Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3,0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="RowLabel"/>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="RowValue"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Tutte e tre in alto: la spiegazione va a capo su
                                                     due righe e, centrata, sfalserebbe il valore
                                                     rispetto all'etichetta. -->
                                                <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Top" Margin="0,0,12,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Value}"
                                                           Style="{StaticResource RowValue}"
                                                           VerticalAlignment="Top" Margin="0,0,12,0"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Hint}"
                                                           Style="{StaticResource Hint}"
                                                           VerticalAlignment="Top" Margin="0,0,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Cio' che Windows ha registrato: completa lo SMART, non lo sostituisce. -->
                                <TextBlock Text="{Binding EventsText}" Style="{StaticResource Hint}"
                                           Margin="0,10,0,0"/>
                            </StackPanel>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
