<ui:FluentWindow x:Class="RoboKeep.LogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:l="clr-namespace:RoboKeep.Localization"
        Title="{l:Tr LogView_Title}" Width="900" Height="620"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
        WindowCornerPreference="Round" WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" x:Name="ViewerTitle" Title="{l:Tr LogView_Title}">
            <ui:TitleBar.Icon><ui:SymbolIcon Symbol="History24"/></ui:TitleBar.Icon>
        </ui:TitleBar>
        <Border Grid.Row="1" CornerRadius="6" Background="#1E1E1E" Margin="16,4,16,16" Padding="8">
            <TextBox x:Name="LogText" IsReadOnly="True" Style="{x:Null}"
                     FontFamily="Cascadia Mono, Consolas" FontSize="12"
                     Background="#1E1E1E" Foreground="#D4D4D4" CaretBrush="#D4D4D4"
                     BorderThickness="0" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
        </Border>
    </Grid>
</ui:FluentWindow>
