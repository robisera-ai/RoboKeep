<ui:FluentWindow x:Class="RoboKeep.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:l="clr-namespace:RoboKeep.Localization"
        xmlns:local="clr-namespace:RoboKeep"
        mc:Ignorable="d"
        Title="{l:Tr Main_Title}" Height="680" Width="1040"
        Icon="pack://application:,,,/Assets/app.ico"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{l:Tr Main_Title}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.ico"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Barra azioni -->
        <Grid Grid.Row="1" Margin="16,4,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <ui:Button Icon="{ui:SymbolIcon Add24}" Content="{l:Tr Main_New}" Click="OnNewJob" Margin="0,0,8,0"/>
                <ui:Button Icon="{ui:SymbolIcon Edit24}" Content="{l:Tr Main_Edit}" Click="OnEditJob" Margin="0,0,8,0"/>
                <ui:Button Icon="{ui:SymbolIcon Delete24}" Content="{l:Tr Main_Delete}" Click="OnDeleteJob" Margin="0,0,8,0"/>
                <Separator Margin="6,4" Background="#33888888"/>
                <ui:Button Icon="{ui:SymbolIcon Eye24}" Content="{Binding PreviewLabel}" Command="{Binding PreviewSelectedCommand}"
                           Appearance="{Binding PreviewCancel, Converter={StaticResource CancelAppearance}, ConverterParameter=Secondary}" Margin="0,0,8,0"/>
                <ui:Button Icon="{ui:SymbolIcon Play24}" Content="{Binding RunSelectedLabel}" Command="{Binding RunSelectedCommand}"
                           Appearance="{Binding RunSelectedCancel, Converter={StaticResource CancelAppearance}, ConverterParameter=Primary}" Margin="0,0,8,0"/>
                <ui:Button Icon="{ui:SymbolIcon FastForward24}" Content="{Binding RunAllLabel}" Command="{Binding RunAllCommand}"
                           Appearance="{Binding RunAllCancel, Converter={StaticResource CancelAppearance}, ConverterParameter=Secondary}" Margin="0,0,8,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Icon="{ui:SymbolIcon ArrowSync24}" ToolTip="{l:Tr Main_Refresh}"
                           Command="{Binding RefreshCommand}" Margin="0,0,8,0"/>
                <ui:Button Icon="{ui:SymbolIcon Settings24}" Content="{l:Tr Main_Settings}" Click="OnSettings"/>
            </StackPanel>
        </Grid>

        <!-- Contenuto: tabella job + log -->
        <Grid Grid.Row="2" Margin="16,0,16,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1.1*"/>
            </Grid.RowDefinitions>

            <ui:InfoBar Grid.Row="0"
                        Severity="Warning"
                        IsOpen="{Binding HealthBannerVisible}"
                        IsClosable="False"
                        Title="{l:Tr Health_BannerTitle}"
                        Message="{Binding HealthBannerText}"
                        Margin="0,0,0,8"/>

            <Border Grid.Row="1" CornerRadius="8" BorderThickness="1"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <Grid>
                    <DataGrid x:Name="JobsGrid" ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob}"
                              AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="None"
                              Background="Transparent" BorderThickness="0"
                              VerticalAlignment="Stretch" VerticalContentAlignment="Top"
                              Visibility="{Binding HasJobs, Converter={StaticResource BoolToVis}}"
                              AllowDrop="True"
                              MouseMove="OnGridMouseMove"
                              DragOver="OnGridDragOver"
                              Drop="OnGridDrop"
                              PreviewMouseLeftButtonDown="OnGridPreviewLeftDown"
                              MouseDoubleClick="OnEditJob">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Health}" Value="Failed">
                                        <Setter Property="Background" Value="#33FF5252"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Health}" Value="Stale">
                                        <Setter Property="Background" Value="#33FFB300"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="40" CanUserResize="False" CanUserReorder="False" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="Transparent" Cursor="SizeAll" ToolTip="{l:Tr DragHint}"
                                                Padding="8,0" PreviewMouseLeftButtonDown="OnDragHandleMouseDown">
                                            <ui:SymbolIcon Symbol="ReOrderDotsVertical24" FontSize="18" Opacity="0.5"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{l:Tr Col_Active}" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ui:ToggleSwitch IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{l:Tr Col_Name}" Binding="{Binding Name}" Width="170" IsReadOnly="True"/>
                            <DataGridTextColumn Header="{l:Tr Col_Mode}" Binding="{Binding ModeLabel}" Width="100" IsReadOnly="True"/>
                            <DataGridTextColumn Header="{l:Tr Col_Source}" Binding="{Binding Source}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="{l:Tr Col_Dest}" Binding="{Binding Destination}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="{l:Tr Col_LastResult}" Binding="{Binding LastStatus}" Width="380" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Stato vuoto -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                        <ui:SymbolIcon Symbol="FolderAdd24" FontSize="46" HorizontalAlignment="Center" Opacity="0.55"/>
                        <TextBlock Text="{l:Tr Empty_Title}" FontSize="18" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,12,0,4"/>
                        <TextBlock Text="{l:Tr Empty_Desc}" TextAlignment="Center" TextWrapping="Wrap" Opacity="0.7"/>
                        <ui:Button Content="{l:Tr Empty_Button}" Icon="{ui:SymbolIcon Add24}" Appearance="Primary"
                                   HorizontalAlignment="Center" Margin="0,16,0,0" Click="OnNewJob"/>
                    </StackPanel>
                </Grid>
            </Border>

            <GridSplitter Grid.Row="2" Height="10" HorizontalAlignment="Stretch" Background="Transparent"/>

            <ui:Card Grid.Row="3" Padding="0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="12,10,12,6">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="SlideText24" Margin="0,0,8,0"/>
                            <TextBlock Text="{l:Tr Main_LogTitle}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ui:Button HorizontalAlignment="Right" Icon="{ui:SymbolIcon Eraser24}" Content="{l:Tr Main_Clear}"
                                   Appearance="Secondary" Command="{Binding ClearLogCommand}"/>
                    </Grid>
                    <Border Margin="12,0,12,12" CornerRadius="6" Background="#1E1E1E">
                        <TextBox x:Name="LogBox" IsReadOnly="True" Style="{x:Null}"
                                 FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 Background="#1E1E1E" Foreground="#DDDDDD" CaretBrush="#DDDDDD"
                                 BorderThickness="0" Padding="8"/>
                    </Border>
                </DockPanel>
            </ui:Card>
        </Grid>

        <!-- Barra di stato -->
        <Border Grid.Row="3" Padding="16,8" Background="#11888888">
            <Grid>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Opacity="0.8"/>
                <ui:ProgressRing HorizontalAlignment="Right" Width="20" Height="20"
                                 IsIndeterminate="{Binding IsBusy}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
